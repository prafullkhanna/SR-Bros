# Public site URL (no trailing slash) — used for canonical URLs, sitemap and OG tags
NEXT_PUBLIC_SITE_URL=https://srbros.in

# Analytics (all optional — features are skipped when the value is empty)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Contact form delivery (SMTP — Hostinger mailbox)
# Without these the form returns an honest error instead of pretending to send.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@srbros.in
SMTP_PASSWORD=
CONTACT_TO=hello@srbros.in
